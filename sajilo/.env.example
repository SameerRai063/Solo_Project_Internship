# Copy this file to .env and fill it in. Never commit .env.
LLM_API_KEY=your-api-key-here

# Any OpenAI-compatible endpoint works. Leave blank to use OpenAI itself.
# Examples (confirm in your provider's docs):
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
LLM_BASE_URL=

# Use a current model name from your provider's docs. Names change often.
LLM_MODEL=

# Lower means more consistent output. Leave empty if your model rejects this setting.
LLM_TEMPERATURE=0.2
